SERVED_NAME=qwen38-27b-nvfp4-dflash2-fp8kv-1x256k-text-image-cu130
MODE=fast
MODEL_FAMILY=qwen
PROFILE_GROUP=qwen3.8-27b-nvfp4-dflash2
MODEL_VARIANT=nvfp4
QUANTIZATION=compressed-tensors
KV_CACHE_DTYPE=fp8
# 本地改动(2026-09-20)：并发1->8 后 mamba 状态缓存乘 8 倍 + K=7，
# 262144 装不下（实测可用 4.82 < 需要 4.83 GiB，vLLM 算出上限 258736）。
# 原版 262144 见 .bak-262144。MAX_MODEL_LEN 不吃 launcher 的 --set，只能改这里。
MAX_MODEL_LEN=252000
GPU_UTIL=0.96
MAX_BATCHED_TOKENS=4096
MAX_NUM_SEQS=1
SPECULATIVE_METHOD=dflash
SPECULATIVE_TOKENS=7
MESSAGE_TYPE=text+image
