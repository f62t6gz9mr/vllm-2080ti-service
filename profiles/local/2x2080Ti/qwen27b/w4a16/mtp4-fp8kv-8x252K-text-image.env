# 本地路线预设（不在官方矩阵里，放在 profiles/local 下，update.sh 会原样保留）
# 来源：v0.2.1-RC 时期的 profiles/2x2080Ti/qwen27b/w4a16/normal/mtp-fp8kv-1x240k-text-image.env
# 2026-10-02 随 v0.2.2-post3 移植：官方把 profile 扁平化并删掉了 w4a16 的 MTP text+image 档，
# 同时收紧了允许键（SERVED_NAME / PROFILE_GROUP 不再允许写进路线 profile，改用 launcher --set 传）。
# 保留的实际生效参数：8 并发 / 252000 上下文 / MTP4 / FP8 KV / text+image / GPU_UTIL 0.95。
MODE=normal
MODEL_FAMILY=qwen35
MODEL_VARIANT=nvfp4
QUANTIZATION=compressed-tensors
KV_CACHE_DTYPE=fp8
MAX_MODEL_LEN=252000
GPU_UTIL=0.95
MAX_BATCHED_TOKENS=2048
MAX_NUM_SEQS=8
SPECULATIVE_METHOD=mtp
SPECULATIVE_TOKENS=4
MESSAGE_TYPE=text+image
