+    def _submit_writeback(self, req_context: ReqContext) -> None:
+        """PATCH 6 SGLang write-back: 把被驱逐但还没上盘的砖提交落盘。
+        这些 chunk 已被 LRU 摘走但槽位被 cpu 层扣住 (数据还在!), 用扣住的
