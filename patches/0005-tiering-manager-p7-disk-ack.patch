+        items = self.primary_tier.wb_drain_pending()
+        if not items:
+            return
+        keys = [k for k, _ in items]
+        chunk_ids = np.array([c.chunk_id for _, c in items], dtype=np.int32)
+        job_metadata = TransferJob(
+            job_id=self._next_job_id(),
+            keys=keys,
+            chunk_ids=chunk_ids,
+            is_promotion=False,
+            req_context=req_context,
+        )
+        try:
+            tier = self.secondary_tiers[0]
+            self._register_job(job_metadata, 0)
+            self._wb_job_ids.add(job_metadata.job_id)
+            tier.submit_store(job_metadata)
+        except Exception:
+            self._wb_job_ids.discard(job_metadata.job_id)
+            self._jobs.pop(job_metadata.job_id, None)
+            self.primary_tier.wb_requeue(items)
