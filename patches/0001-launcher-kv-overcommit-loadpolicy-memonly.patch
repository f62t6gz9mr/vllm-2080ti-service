   if [[ ! "$max_num_seqs" =~ ^[1-9][0-9]*$ ]] || (( max_num_seqs <= 1 )); then
     return 0
   fi
+  # LOCAL PATCH (2026-11-21) ALLOW_KV_OVERCOMMIT=1
+  # 官方预检要求 KV池 >= MAX_NUM_SEQS x MAX_MODEL_LEN，即"每个槽位都要能装下满上下文"。
+  # 本地改为总量预检：KV池 >= MAX_MODEL_LEN 即可启动，多个会话按 sum(KV) 共享 26.4 万 tokens，
+  # 超过就排队/由 scheduler 抢占（num_computed_tokens=0 重算）。代价：两个会话同时接近满上下文时
+  # 会互相抢占。真实并发由网关 :8001 的 MAX_INFLIGHT 排队控制。update.sh 会覆盖本文件，需重打。
+  if [[ "${ALLOW_KV_OVERCOMMIT:-0}" == "1" ]]; then
+    if [[ ! "$max_model_len" =~ ^[1-9][0-9]*$ ]]; then
+      echo "ERROR: cannot validate KV capacity: invalid MAX_MODEL_LEN=$max_model_len" >&2
+      return 1
+    fi
+    total=$(kv_cache_total_tokens_from_log "$log_file" 2>/dev/null || true)
+    if [[ ! "$total" =~ ^[1-9][0-9]*$ ]]; then
+      echo "ERROR: cannot validate KV capacity: GPU KV token capacity is missing from the startup log." >&2
+      return 1
+    fi
+    if (( total < max_model_len )); then
+      echo "ERROR: single request context does not fit in the allocated GPU KV cache." >&2
+      echo "  GPU KV tokens: $total / MAX_MODEL_LEN: $max_model_len" >&2
+      return 1
+    fi
+    echo "KV concurrency check: OVERCOMMIT (KV $total tokens shared by up to $max_num_seqs requests, each <= $max_model_len; sum > pool = preempt/requeue)"
+    return 0
+  fi
+
   if [[ ! "$max_model_len" =~ ^[1-9][0-9]*$ ]]; then
     echo "ERROR: cannot validate KV concurrency: invalid MAX_MODEL_LEN=$max_model_len" >&2
     return 1
