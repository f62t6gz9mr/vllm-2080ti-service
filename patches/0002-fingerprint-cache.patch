+def _prefetch_into_page_cache(files: list[Path], streams: int = 4) -> None:
+    """Warm the page cache with parallel buffered reads before hashing.
+
+    This host's NVMe only sustains ~54 MB/s per sequential stream but
+    ~223 MB/s aggregate with 4 concurrent streams, so reading ahead in
+    parallel makes the single-stream hash below effectively cache-bound.
+    Buffered reads only; correctness is still verified by the hashing pass.
+    """
+    import time
+    from concurrent.futures import ThreadPoolExecutor
+
+    block = 8 * 1024 * 1024
+
+    def _worker(path: Path) -> None:
+        try:
+            size = path.stat().st_size
+            with path.open("rb") as source:
+                offset = 0
+                while offset < size:
+                    source.seek(offset)
+                    chunk = source.read(block)
+                    if not chunk:
+                        break
+                    offset += len(chunk)
+        except OSError:
+            pass  # prefetch is advisory; the hashing pass reports real errors
+
+    t0 = time.monotonic()
+    with ThreadPoolExecutor(max_workers=streams) as pool:
+        list(pool.map(_worker, files))
+    print(
+        f"prefetch: {sum(f.stat().st_size for f in files) / 2**30:.1f} GiB "
+        f"in {time.monotonic() - t0:.1f}s ({streams} streams)",
+        file=sys.stderr,
+    )
+
+
+def _cache_path() -> Path:
+    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
+    return Path(base) / "vllm-def" / "fingerprint-cache.json"
+
+
+def _stat_key(model_dir: str, draft_dir: str) -> list[list]:
+    """Cheap identity of the exact file set + stat of each file.
+
+    A weight swap (new file, new size, new mtime) changes this key and
+    forces a full content re-hash; an untouched checkpoint reuses the
+    cached fingerprint and skips reading ~26 GiB at boot.
+    """
+    key = []
+    for directory in (model_dir, draft_dir):
+        if not directory:
+            continue
+        root = Path(directory).resolve(strict=True)
+        for path in _checkpoint_files(root, "stat"):
+            st = path.stat()
+            key.append(
+                [
+                    path.relative_to(root).as_posix(),
+                    st.st_dev,
+                    st.st_ino,
+                    st.st_size,
+                    st.st_mtime_ns,
+                    st.st_ctime_ns,
+                ]
+            )
+    return key
+
+
+def _load_cached(model_dir: str, draft_dir: str) -> str | None:
+    import json
+
+    try:
+        raw = json.loads(_cache_path().read_text())
+    except (OSError, ValueError):
+        return None
+    if raw.get("version") != 1 or raw.get("key") != _stat_key(model_dir, draft_dir):
+        return None
+    digest = raw.get("fingerprint")
+    return digest if isinstance(digest, str) and len(digest) == 64 else None
+
+
+def _store_cached(model_dir: str, draft_dir: str, digest: str) -> None:
+    import json
+
+    path = _cache_path()
+    try:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        tmp = path.with_suffix(".tmp")
+        tmp.write_text(
+            json.dumps(
+                {
+                    "version": 1,
+                    "key": _stat_key(model_dir, draft_dir),
+                    "fingerprint": digest,
+                }
+            )
+        )
+        tmp.replace(path)
+    except OSError:
+        pass  # cache is an optimisation; never fail the launch over it
+
+
